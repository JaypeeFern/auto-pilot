      {
         "id" : "8a7f378d-440e-4cae-8415-16b2b924f5ce",
         "name" : "Normalize Bookings",
         "parameters" : {
            "jsCode" : "const TZ = 'Asia/Manila'; const DEVICES = ['Iphone 13', 'Canon EOS R50', 'Insta360 X5', 'DJI Osmo Pocket 3']; const ACTIVE = ['booked', 'released']; function normDate(v) { if (v === null || v === undefined || v === '') return ''; if (typeof v === 'number') { const b = new Date(Date.UTC(1899, 11, 30)); b.setUTCDate(b.getUTCDate() + Math.floor(v)); return b.toISOString().slice(0, 10); } const str = String(v).trim(); const m = str.match(/^(\\d{4})-(\\d{2})-(\\d{2})/); if (m) return m[0]; const d = new Date(str); if (isNaN(d.getTime())) return ''; return new Intl.DateTimeFormat('en-CA', { timeZone: TZ, year: 'numeric', month: '2-digit', day: '2-digit' }).format(d); } function timeMins(t) { if (t === null || t === undefined || t === '') return -1; const str = String(t).trim().toUpperCase(); const m = str.match(/^(\\d{1,2}):(\\d{2})(:\\d{2})?\\s*(AM|PM)?$/); if (!m) return -1; let h = Number(m[1]); const mi = Number(m[2]); const ap = m[4]; if (ap) { if (h < 1 || h > 12) return -1; if (ap === 'PM' && h < 12) h += 12; if (ap === 'AM' && h === 12) h = 0; } else { if (h > 23) return -1; } if (mi > 59) return -1; return h * 60 + mi; } function stamp(iso, m) { const p = iso.split('-'); return Date.UTC(Number(p[0]), Number(p[1]) - 1, Number(p[2])) + m * 60000 - 8 * 3600000; } function pickBal(j) { const a = j['Balance']; if (a !== null && a !== undefined && String(a).trim() !== '') return String(a); const b = j['Remaining']; if (b === null || b === undefined) return ''; return String(b); } const out = []; for (const it of $input.all()) { const j = it.json || {}; if (!j.device || DEVICES.indexOf(j.device) < 0) continue; const status = String(j.Status || '').trim().toLowerCase(); const sd = normDate(j['Start Date']); const ed = normDate(j['End Date']); const tm = timeMins(j.Time); const problems = []; if (sd === '') problems.push('bad Start Date'); if (ed === '') problems.push('bad End Date'); if (tm < 0) problems.push('bad Time'); out.push({ json: { device: j.device, statusRaw: String(j.Status || ''), status: status, isActive: ACTIVE.indexOf(status) >= 0, startDate: sd, endDate: ed, timeRaw: String(j.Time || ''), timeMins: tm, startStamp: problems.length === 0 ? stamp(sd, tm) : null, endStamp: problems.length === 0 ? stamp(ed, tm) : null, valid: problems.length === 0, invalidReason: problems.join('; '), renterName: String(j['Renter Name'] || ''), address: String(j.Address || ''), notes: String(j.Notes || ''), balance: pickBal(j), downPayment: String(j['Down Payment'] || ''), diveCase: String(j['Dive Case'] || '') } }); } return out;",
            "mode" : "runOnceForAllItems"
         },
