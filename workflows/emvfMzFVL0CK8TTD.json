         "id" : "06332599-b7ff-4b6a-adfa-e8fb31044414",
         "name" : "Check Availability",
         "parameters" : {
            "jsCode" : "const req = $('Parse Request').first().json; const Y = req.year; const MO = req.month; const T = req.timeMins; const DEVICES = ['Iphone 13', 'Canon EOS R50', 'Insta360 X5', 'DJI Osmo Pocket 3']; function normDate(v) { if (v === null || v === undefined || v === '') return ''; if (typeof v === 'number') { const b = new Date(Date.UTC(1899, 11, 30)); b.setUTCDate(b.getUTCDate() + Math.floor(v)); return b.toISOString().slice(0, 10); } const str = String(v).trim(); const m = str.match(/^(\\d{4})-(\\d{2})-(\\d{2})/); if (m) return m[0]; const d = new Date(str); if (isNaN(d.getTime())) return ''; return new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Manila', year: 'numeric', month: '2-digit', day: '2-digit' }).format(d); } function mins(t) { if (t === null || t === undefined || t === '') return 99999; const str = String(t).trim().toUpperCase(); const m = str.match(/^(\\d{1,2}):(\\d{2})(:\\d{2})?\\s*(AM|PM)?$/); if (!m) return 99999; let h = Number(m[1]); const mi = Number(m[2]); const ap = m[4]; if (ap === 'PM' && h < 12) h += 12; if (ap === 'AM' && h === 12) h = 0; return h * 60 + mi; } function stamp(iso, m) { const p = iso.split('-'); return Date.UTC(Number(p[0]), Number(p[1]) - 1, Number(p[2])) + m * 60000 - 8 * 3600000; } function shortDT(ms) { const d = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Manila', month: 'short', day: 'numeric' }).format(new Date(ms)); const t = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Manila', hour: 'numeric', minute: '2-digit', hour12: true }).format(new Date(ms)); return d + ', ' + t; } const rows = []; for (const it of $input.all()) { const c = it.json || {}; const j = { device: c.device || '', Status: c.statusRaw || '', 'Start Date': c.startDate || '', 'End Date': c.endDate || '', Time: c.timeRaw || '' }; if (!j.device || DEVICES.indexOf(j.device) < 0) continue; rows.push(j); } const tp = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Manila', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date()).split('-'); const tKey = Number(tp[0]) * 10000 + Number(tp[1]) * 100 + Number(tp[2]); const lastDay = new Date(Date.UTC(Y, MO + 1, 0)).getUTCDate(); const out = []; for (const dev of DEVICES) { const mine = rows.filter(j => j.device === dev); let unknown = false; const act = []; for (const j of mine) { const st = String(j.Status || '').trim().toLowerCase(); if (st !== 'booked' && st !== 'released') continue; const sd = normDate(j['Start Date']); const ed = normDate(j['End Date']); const m = mins(j.Time); if (sd === '' || ed === '' || m >= 99999) { unknown = true; continue; } act.push({ s: stamp(sd, m), e: stamp(ed, m) }); } const freeDays = []; const blocked = []; if (!unknown) { for (let d = 1; d <= lastDay; d += 1) { if (Y * 10000 + (MO + 1) * 100 + d < tKey) continue; const s = Date.UTC(Y, MO, d) + T * 60000 - 8 * 3600000; const e = s + 24 * 3600000; const reasons = []; for (const a of act) { if (s < a.e && a.s < e) { if (a.e > s && a.s <= s) reasons.push('return ' + shortDT(a.e)); else reasons.push('next pickup ' + shortDT(a.s)); if (reasons.length >= 2) break; } } if (reasons.length === 0) { freeDays.push(d); } else { blocked.push({ d: d, why: reasons.join('; ') }); } } } const ranges = []; let rs = -1, prev = -2; for (const d of freeDays) { if (d !== prev + 1) { if (rs >= 0) ranges.push([rs, prev]); rs = d; } prev = d; } if (rs >= 0) ranges.push([rs, prev]); out.push({ device: dev, unknown: unknown, ranges: ranges, blocked: blocked }); } return [{ json: { year: Y, month: MO, timeMins: T, monthLabel: req.monthLabel, timeLabel: req.timeLabel, results: out } }];",
