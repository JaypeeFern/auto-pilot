         "parameters" : {
            "jsCode" : "const d = $input.first().json; const EMOJI = { 'Iphone 13': '📱', 'Canon EOS R50': '📷', 'Insta360 X5': '🎥', 'DJI Osmo Pocket 3': '🚁' }; function esc(v) { return String(v === null || v === undefined ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); } function mName(y, mo) { return new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Manila', month: 'long' }).format(new Date(Date.UTC(y, mo, 1))); } function fmtRange(y, mo, r, lastDay) { const mn = mName(y, mo); if (r[0] === r[1]) return mn + ' ' + r[0]; if (r[1] >= lastDay) return mn + ' ' + r[0] + ' onwards'; return mn + ' ' + r[0] + ' to ' + r[1]; } function shortDay(y, mo, dd) { return new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Manila', month: 'short', day: 'numeric' }).format(new Date(Date.UTC(y, mo, dd))); } function devLabel(dev) { const icon = EMOJI[dev] ? EMOJI[dev] + ' ' : ''; return icon + '<b>' + esc(dev) + '</b>'; } const lastDay = new Date(Date.UTC(d.year, d.month + 1, 0)).getUTCDate(); const lines = []; lines.push('📅 <b>' + esc(d.monthLabel) + ' Availability</b>'); lines.push('<i>24-hour rentals from ' + esc(d.timeLabel) + ' daily</i>'); for (const r of d.results) { lines.push(''); lines.push(devLabel(r.device)); if (r.unknown) { lines.push('Unverified entries - check sheet ⚠️'); } else if (r.ranges.length === 0) { lines.push('No free days.'); } else { for (const g of r.ranges) lines.push(fmtRange(d.year, d.month, g, lastDay)); } } let anyBlocked = false; for (const r of d.results) { if (!r.unknown && r.blocked && r.blocked.length > 0) { anyBlocked = true; break; } } if (anyBlocked) { lines.push(''); lines.push('🚫 <b>Not free</b>'); for (const r of d.results) { if (r.unknown || !r.blocked || r.blocked.length === 0) continue; lines.push(''); lines.push(devLabel(r.device)); const groups = []; let cur = null; for (const b of r.blocked) { if (cur && b.d === cur.end + 1 && b.why === cur.why) { cur.end = b.d; } else { if (cur) groups.push(cur); cur = { start: b.d, end: b.d, why: b.why }; } } if (cur) groups.push(cur); for (const g of groups) { const dl = g.start === g.end ? shortDay(d.year, d.month, g.start) : shortDay(d.year, d.month, g.start) + ' to ' + g.end; lines.push(dl + ' - ' + esc(g.why)); } } } return [{ json: { telegramMessage: lines.join('\\n') } }];",
