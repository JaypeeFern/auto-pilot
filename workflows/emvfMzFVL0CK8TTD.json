         "parameters" : {
            "jsCode" : "const req = $('Parse Request').first().json; const s = req.startMs; const e = req.endMs; const DEVICES = ['Iphone 13', 'Canon EOS R50', 'Insta360 X5', 'DJI Osmo Pocket 3']; function normDate(v) { if (v === null || v === undefined || v === '') return ''; if (typeof v === 'number') { const b = new Date(Date.UTC(1899, 11, 30)); b.setUTCDate(b.getUTCDate() + Math.floor(v)); return b.toISOString().slice(0, 10); } const str = String(v).trim(); const m = str.match(/^(\\d{4})-(\\d{2})-(\\d{2})/); if (m) return m[0]; const d = new Date(str); if (isNaN(d.getTime())) return ''; return new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Manila', year: 'numeric', month: '2-digit', day: '2-digit' }).format(d); } function mins(t) { if (t === null || t === undefined || t === '') return 99999; const str = String(t).trim().toUpperCase(); const m = str.match(/^(\\d{1,2}):(\\d{2})(:\\d{2})?\\s*(AM|PM)?$/); if (!m) return 99999; let h = Number(m[1]); const mi = Number(m[2]); const ap = m[4]; if (ap === 'PM' && h < 12) h += 12; if (ap === 'AM' && h === 12) h = 0; return h * 60 + mi; } function stamp(iso, m) { const p = iso.split('-'); return Date.UTC(Number(p[0]), Number(p[1]) - 1, Number(p[2])) + m * 60000 - 8 * 3600000; } function shortD(ms) { return new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Manila', month: 'short', day: 'numeric' }).format(new Date(ms)); } function shortT(ms) { const parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Manila', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date(ms)).split(':'); let h = Number(parts[0]); const mi = parts[1]; const ap = h >= 12 ? 'PM' : 'AM'; if (h === 0) h = 12; if (h > 12) h -= 12; return h + ':' + mi + ' ' + ap; } const rows = []; for (const it of $input.all()) { const j = it.json || {}; if (!j.device || DEVICES.indexOf(j.device) < 0) continue; rows.push(j); } const out = []; for (const dev of DEVICES) { let state = 'free'; let by = ''; let until = ''; for (const j of rows) { if (j.device !== dev) continue; const st = String(j.Status || '').trim().toLowerCase(); if (st !== 'booked' && st !== 'released') continue; const sd = normDate(j['Start Date']); const ed = normDate(j['End Date']); const m = mins(j.Time); if (sd === '' || ed === '' || m >= 99999) { if (state === 'free') state = 'unknown'; continue; } const rs = stamp(sd, m); const re = stamp(ed, m); if (s < re && rs < e) { state = 'taken'; by = String(j['Renter Name'] || '').trim(); until = shortD(re) + ', ' + shortT(re); break; } } out.push({ device: dev, state: state, by: by, until: until }); } return [{ json: { startMs: s, endMs: e, dayLabel: req.dayLabel, timeLabel: req.timeLabel, results: out } }];",
