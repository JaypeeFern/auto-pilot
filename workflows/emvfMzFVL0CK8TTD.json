ror: 'Could not understand the time. Try /avail Sep 20 9am' } }]; const startMs = Date.UTC(yy, mmo, ddo) + mins * 60000 - 8 * 3600000; return [{ json: { ok: true, startMs: startMs, endMs: startMs + 24 * 3600000, dayLabel: fmtDay(yy, mmo, ddo), timeLabel: fmtTime(mins) } }]; } else if ((m = low.match(/^(\\d{1,2})(st|nd|rd|th)?\\s+([a-z]+)\\b\\s*(.*)$/))) { day = Number(m[1]); mo = mIdx(m[3]); rest = m[4]; } else if ((m = low.match(/^([a-z]+)\\s+(\\d{1,2})(st|nd|rd|th)?\\b\\s*(.*)$/))) { mo = mIdx(m[1]); day = Number(m[2]); rest = m[4]; } else if ((m = low.match(/^(\\d{1,2})[\\/\\-](\\d{1,2})\\s*(.*)$/))) { day = Number(m[1]); mo = Number(m[2]) - 1; if (mo < 0 || mo > 11) mo = -1; rest = m[3]; } else { return [{ json: { ok: false, error: 'Could not understand the date. Try /avail Sep 20 9am' } }]; } if (day < 1 || day > 31 || mo < 0) return [{ json: { ok: false, error: 'Could not understand the date. Try /avail Sep 20 9am' } }]; const mins = pTime(rest); if (mins === null) return [{ json: { ok: false, error: 'Could not understand the time. Try /avail Sep 20 9am' } }]; const td0 = manilaToday().split('-'); let y0 = Number(td0[0]); const todayKey = Number(td0[0]) * 10000 + Number(td0[1]) * 100 + Number(td0[2]); let roll = 0; while ((y0 * 10000 + (mo + 1) * 100 + day) < todayKey && roll < 12) { mo += 1; if (mo > 11) { mo = 0; y0 += 1; } roll += 1; } const dd = new Date(Date.UTC(y0, mo, day)); const y = dd.getUTCFullYear(); const mm = dd.getUTCMonth(); const dd2 = dd.getUTCDate(); const startMs = Date.UTC(y, mm, dd2) + mins * 60000 - 8 * 3600000; return [{ json: { ok: true, startMs: startMs, endMs: startMs + 24 * 3600000, dayLabel: fmtDay(y, mm, dd2), timeLabel: fmtTime(mins) } }];",
