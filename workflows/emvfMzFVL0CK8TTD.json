            "jsCode" : "const raw = String((($input.first().json.message || {}).text) || ''); const t0 = raw.replace(/^\\/avail(@[A-Za-z0-9_]+)?\\b/i, '').trim(); function mIdx(n) { n = String(n || '').toLowerCase(); if (/^\\d+$/.test(n)) { const v = Number(n); if (v >= 1 && v <= 12) return v - 1; return -1; } const k = n.slice(0, 3); const all = 'janfebmaraprmayjunjulaugsepoctnovdec'; const i = all.indexOf(k); if (i < 0 || i % 3 !== 0) return -1; return i / 3; } function pTime(s) { s = String(s || '').trim().toLowerCase().replace(/\\./g, ''); if (s === '') return 0; const m = s.match(/^(\\d{1,2})(?::(\\d{2}))?\\s*(am|pm)?$/); if (!m) return null; let h = Number(m[1]); const mi = m[2] ? Number(m[2]) : 0; const ap = m[3]; if (ap) { if (h < 1 || h > 12) return null; if (ap === 'pm' && h < 12) h += 12; if (ap === 'am' && h === 12) h = 0; } else { if (h > 23) return null; } if (mi > 59) return null; return h * 60 + mi; } function manilaParts() { const p = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Manila', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date()).split('-'); return { y: Number(p[0]), mo: Number(p[1]) - 1, d: Number(p[2]) }; } function fmtTime(mins) { let h = Math.floor(mins / 60); const mi = mins % 60; const ap = h >= 12 ? 'PM' : 'AM'; if (h === 0) h = 12; if (h > 12) h -= 12; return h + ':' + (mi < 10 ? '0' + mi : mi) + ' ' + ap; } function monthLabel(y, mo) { return new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Manila', month: 'long', year: 'numeric' }).format(new Date(Date.UTC(y, mo, 1))); } const now = manilaParts(); let t = t0.toLowerCase(); let timeFirst = null; const mt = t.match(/^(\\d{1,2}:\\d{2}|\\d{1,2}\\s*(?:am|pm))\\s+(.+)$/); if (mt) { const pv = pTime(mt[1]); if (pv !== null) { timeFirst = pv; t = mt[2]; } } let mo = -1, rest = '', m = null; const low = t; if (low === '') { mo = now.mo; rest = ''; var yy0 = now.y; } else if ((m = low.match(/^(today|tomorrow)\\b\\s*(.*)$/))) { mo = now.mo; rest = m[2]; var yy0 = now.y; } else if ((m = low.match(/^([a-z]+)\\s+(\\d{1,2})(st|nd|rd|th)?\\b\\s*(.*)$/)) && mIdx(m[1]) >= 0) { mo = mIdx(m[1]); rest = m[4]; var yy0 = now.y; if (mo < now.mo) yy0 += 1; } else if ((m = low.match(/^([a-z]+)\\s*(.*)$/)) && mIdx(m[1]) >= 0 && !/\\d/.test(m[1])) { mo = mIdx(m[1]); rest = m[2]; var yy0 = now.y; if (mo < now.mo) yy0 += 1; } else if ((m = low.match(/^(\\d{1,2})(st|nd|rd|th)?\\s+([a-z]+)\\b\\s*(.*)$/))) { mo = mIdx(m[3]); rest = m[4]; var yy0 = now.y; if (mo >= 0 && mo < now.mo) yy0 += 1; } else if ((m = low.match(/^(\\d{1,2})[\\/\\-](\\d{1,2})\\s*(.*)$/))) { mo = Number(m[2]) - 1; if (mo < 0 || mo > 11) mo = -1; rest = m[3]; var yy0 = now.y; if (mo >= 0 && mo < now.mo) yy0 += 1; } else { return [{ json: { ok: false, error: 'Could not understand that. Try /avail October 9am' } }]; } if (mo < 0) return [{ json: { ok: false, error: 'Could not understand the month. Try /avail October 9am' } }]; let mins; if (timeFirst !== null) { mins = timeFirst; } else { mins = pTime(rest); } if (mins === null) return [{ json: { ok: false, error: 'Could not understand the time. Try /avail October 9am' } }]; return [{ json: { ok: true, year: yy0, month: mo, timeMins: mins, monthLabel: monthLabel(yy0, mo), timeLabel: fmtTime(mins) } }];",
