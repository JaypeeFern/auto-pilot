# Exporter sidecar image: thin wrapper around the pinned alpine/git image.
#
# Why this exists (and why it is NOT a fork of n8n): Coolify Scheduled Tasks
# execute INSIDE a service container, and the n8n container has no repo
# checkout. The sync scripts must therefore live somewhere with git — but a
# persistent /repo checkout cannot bootstrap itself (chicken-and-egg: the
# task needs git-sync.sh to clone /repo, yet git-sync.sh was expected inside
# /repo). Baking the scripts into this image breaks the cycle: the image
# provides the scripts, the repo_data volume provides the checkout.
# The n8n image itself is untouched.
FROM alpine/git:2.54.0

COPY scripts/git-sync.sh /usr/local/bin/git-sync
COPY scripts/restore-workflows.sh /usr/local/bin/restore-workflows
COPY scripts/export-workflows.sh /usr/local/bin/export-workflows

RUN chmod +x /usr/local/bin/git-sync /usr/local/bin/restore-workflows /usr/local/bin/export-workflows

# Deliver the export script into the shared export_staging volume, then idle.
# The export task runs in the n8n container (it owns the n8n CLI + SQLite),
# which has no checkout and cannot be given a custom image — so this sidecar
# bakes the script into the image and copies it to /exports at startup, where
# the n8n task runs it as `sh /exports/export-workflows.sh`. The `&& exec`
# parks the idle shell AFTER the copy, so Coolify Scheduled Tasks still have a
# running container to exec into.
ENTRYPOINT ["/bin/sh", "-c", "mkdir -p /exports && chmod 777 /exports && cp /usr/local/bin/export-workflows /exports/export-workflows.sh && exec sleep infinity"]
