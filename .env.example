# AutoPilot — environment template
# Copy NEVER commits real values: runtime config lives in Coolify environment
# variables. For local `docker compose` use only: cp .env.example .env
# (.env is git-ignored) and fill in the secrets. The real .env must never be
# committed.
#
# Classification used below:
#   [REQUIRED]  must be set or the stack misbehaves
#   [SECRET]    sensitive — generate once, store in Coolify, never commit/change
#   [OPTIONAL]  safe default baked into docker-compose.yml; set only to override

# ---------------------------------------------------------------- REQUIRED ---
# Public hostname serving both the n8n Web UI and the MCP HTTP endpoint.
# [REQUIRED]
N8N_HOST=auto-pilot.jpfernandez.online

# The protocol clients use to reach n8n (https: behind Cloudflare Tunnel +
# Coolify proxy). n8n itself still listens on plain HTTP port 5678 internally.
# [REQUIRED]
N8N_PROTOCOL=https

# Internal container port. Must match the port Coolify routes the domain to.
# [REQUIRED]
N8N_PORT=5678

# Public base URL of the editor (also used for emails / OAuth redirects).
# [REQUIRED]
N8N_EDITOR_BASE_URL=https://auto-pilot.jpfernandez.online

# Public base URL for webhooks (successor of the deprecated WEBHOOK_URL,
# deprecated since n8n 2.35 — do not set WEBHOOK_URL).
# [REQUIRED]
N8N_WEBHOOK_URL=https://auto-pilot.jpfernandez.online/

# Number of reverse proxies in front of n8n (Cloudflare Tunnel + Coolify
# proxy report X-Forwarded-*; n8n trusts 1 hop). [REQUIRED]
N8N_PROXY_HOPS=1

# ------------------------------------------------------------------ SECRET ---
# Critical secret. Encrypts all n8n credentials. Generate ONCE, keep stable
# across every redeploy and restore — losing/changing it makes all stored
# credentials permanently undecryptable.
# Generate:  openssl rand -hex 32
# [SECRET] [REQUIRED] [GENERATED — set once, then never change]
N8N_ENCRYPTION_KEY=REPLACE_ME_GENERATE_WITH_openssl_rand_hex_32

# ----------------------------------------------------------------- OPTIONAL ---
# Timezone for schedule nodes (Cron etc.) and TZ for the OS inside the
# container. [OPTIONAL, default: UTC]
GENERIC_TIMEZONE=UTC
TZ=UTC

# Node.js heap cap inside the n8n container. Rule of thumb: ~2/3 of mem_limit
# (768m container -> 512 heap, rest for native SQLite/task-runner memory).
# Raise proportionally if the ceiling is ever raised.
# [OPTIONAL, default: --max-old-space-size=512]
NODE_OPTIONS=--max-old-space-size=512

# Database backend. Only `sqlite` is supported by this project — do not add
# postgres/mysql/redis. [OPTIONAL, default: sqlite]
DB_TYPE=sqlite

# Run SQLite VACUUM on startup to reclaim space freed by execution pruning.
# Slightly slower starts; recommended on a disk-constrained VPS.
# [OPTIONAL, default: true]
DB_SQLITE_VACUUM_ON_STARTUP=true

# Harden settings-file permissions to 0600 (official Compose example value).
# [OPTIONAL, default: true]
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# Block workflow expressions / Code nodes from reading environment variables
# (limits secret exfiltration via workflows). [OPTIONAL, default: true]
N8N_BLOCK_ENV_ACCESS_IN_NODE=true

# --- Execution pruning (disk management). Single retention age for ALL ---
# [OPTIONAL, defaults shown]
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false
# LIMITATION: n8n has no separate success/failure retention. With the above,
# failures are also pruned after ~7 days. Documented alternative to keep
# failures ~30 days: EXECUTIONS_DATA_SAVE_ON_SUCCESS=none and
# EXECUTIONS_DATA_MAX_AGE=720 (failures kept 30d, successes discarded).

# --- Built-in instance-level MCP server (docs/MCP.md) ---
# Managed via env so the setting survives redeploys (requires n8n >= 2.20).
# [OPTIONAL, defaults shown]
N8N_MCP_MANAGED_BY_ENV=true
N8N_MCP_ACCESS_ENABLED=true

# --- Workflow-export Git sync (exporter service + Coolify Scheduled Tasks) ---
# The exporter clones this repo itself (Coolify tasks run INSIDE containers,
# so there is no host checkout). Values live ONLY in Coolify env.
# [REQUIRED for scheduled exports]
GIT_REPO_URL=https://github.com/YOUR_USER/auto-pilot.git
# [OPTIONAL, default: main]
GIT_BRANCH=main
# HTTPS token for push. Fine-grained PAT on THIS repo only, minimum permission
#   Contents: Read and write
# (or a Deploy Key with write access if you mount SSH instead — then leave
# this empty and set GIT_SSH_COMMAND accordingly).
# [SECRET] [REQUIRED for scheduled exports]
GIT_TOKEN=REPLACE_ME_GITHUB_FINE_GRAINED_PAT_CONTENTS_READ_WRITE
# Commit identity for export commits. [OPTIONAL, defaults shown]
GIT_AUTHOR_NAME=autopilot-export
GIT_AUTHOR_EMAIL=autopilot-export@localhost

# --- Browser-collector (giveaway noVNC + persistent Facebook session) ---
# VNC password protecting the noVNC browser. Required by the browser
# service entrypoint; used together with the Cloudflare Access rule on the
# noVNC route (docs/DEPLOYMENT.md). Generate once, store in Coolify only.
# Generate:  openssl rand -base64 24
# [SECRET] [REQUIRED when the browser service is deployed]
VNC_PASSWORD=REPLACE_ME_GENERATE_WITH_openssl_rand_base64_24

# ------------------------------------------------- INTENTIONALLY NOT SET ----
# WEBHOOK_URL            — deprecated alias of N8N_WEBHOOK_URL since n8n 2.35.
# N8N_RUNNERS_ENABLED    — deprecated since n8n 2.0 (task runners always on).
# N8N_TRUST_PROXY        — not an official n8n variable; proxy hops are
#                          handled by N8N_PROXY_HOPS. Do not add.
# DB_SQLITE_DATABASE     — undocumented path variable; persistence is handled
#                          by the n8n_data volume mount instead. Do not add.
# N8N_MCP_ACCESS_TOKEN / N8N_MCP_BASE_URL — community-invented variables, not
#                          official. MCP auth is OAuth or a per-user API key
#                          created in the UI (docs/MCP.md). Do not add.
