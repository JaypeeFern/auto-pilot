# Giveaway Tool runtime template. Store real values in the deployment secret
# manager; never commit the real VNC password or Facebook session data.

VNC_PASSWORD=REPLACE_ME_GENERATE_WITH_openssl_rand_base64_24
COLLECTOR_BIND=0.0.0.0
COLLECTOR_ALLOW_NON_LOOPBACK=true
COLLECTOR_PROFILE_DIR=/profile
COLLECTOR_HEADLESS=false
CHROME_PATH=/usr/bin/chromium
PROFILE_DIR=/profile
TZ=UTC

# The n8n workflow's current in-stack contract is http://browser:5679.
# A separately deployed n8n instance must use the private address provided by
# its deployment/network integration; do not expose this API publicly.
