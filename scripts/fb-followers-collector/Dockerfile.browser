# AutoPilot browser-collector — headed Chromium + noVNC + collector API.
#
# PROVEN REQUIREMENT (do not "simplify" this image away): the giveaway
# collector needs ONE persistent browser that is both Puppeteer-driven and
# manually operable from a desktop browser on the VPS. The official n8n image
# ships no Chromium and n8n Code nodes have no network access, so this cannot
# live inside n8n; the locked single-container rule covers n8n itself, and
# this task explicitly authorizes the one additional service (see
# docs/ARCHITECTURE.md). Upgrades are deliberate/manual.
#
# Layout inside the container:
#   Xvfb (:99) -> openbox -> Chromium (headed, DISPLAY=:99, profile /profile)
#   x11vnc (:5900, loopback only, VNC password) <- websockify (:6080, noVNC web)
#   node server.js (:5679, container network only, called by n8n)
#
# Build context is scripts/fb-followers-collector (package.json + server.js
# live here; local `npm start` runs without Docker for development).

FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PUPPETEER_SKIP_DOWNLOAD=true

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        chromium \
        xvfb \
        x11vnc \
        websockify \
        novnc \
        openbox \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json ./
RUN npm install --omit=dev

COPY server.js entrypoint.sh ./
RUN chmod +x entrypoint.sh

# Persistent Facebook session. Backed up per docs/BACKUP.md guidance.
VOLUME ["/profile"]

# 5679 collector API (n8n only) / 5900 VNC (loopback only) /
# 6080 noVNC web (Coolify domain + Cloudflare Access, never public bare).
EXPOSE 5679 5900 6080

ENTRYPOINT ["/app/entrypoint.sh"]
