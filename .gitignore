# Secrets / local runtime — never commit
.env
.env.*
!.env.example

# n8n persistent data (live SQLite DB, keys, settings) — protected by
# Coolify/R2 backups, never by Git
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
.n8n/
backups/

# Temporary export staging (final output lives in workflows/)
.tmp-n8n-export/
.tmp-n8n-restore/

# Operator browser profile for the giveaway collector (holds Facebook
# session cookies) — never commit
scripts/fb-followers-collector/fb-giveaway-profile/

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
